#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Backups / scratch (no forman parte del proyecto)
*.bak
.claude-scratch/

# Python (tool/curriculum) — cache y outputs de debug de gen_curriculum.py
__pycache__/
tree_fragment.html
niveles_resumen.tsv

# Alchemist (golden tests) — PNGs de diagnóstico que arma cada vez que un
# goldenTest() falla (master/test/masked/isolated diff): output de debug
# de la corrida local, nunca la fuente de verdad (esa vive en
# test/golden/goldens/). v0.3.0 encontró 8 de estos ya commiteados por
# error en un checkpoint anterior — no debe volver a pasar.
test/golden/failures/

# Firebase — configuración real de un proyecto (ver AUTH_SETUP.md).
# lib/firebase_options.dart NO está acá: hoy tiene solo valores
# placeholder, versionados a propósito como referencia de formato. El día
# que corras `flutterfire configure` con un proyecto real, sacalo de
# control de versiones vos mismo si el repo es público (ver AUTH_SETUP.md,
# "qué no sube a Git").
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Android signing — credenciales de firma del keystore de release.
# NUNCA subir al repo: contienen contraseñas del keystore.
# Ver android/app/build.gradle.kts para la estructura esperada.
android/key.properties
*.jks
*.keystore

# Android Gradle build directory (subdirectorio — no cubierto por /build/)
android/build/

# iOS Flutter ephemeral (generado por flutter build, nunca fuente de verdad)
ios/Flutter/ephemeral/

# Legacy sounds directory (supersedido por assets/audio/)
sounds/

